generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                  String               @id @default(cuid())
  name                String
  address             String?
  phone               String?
  logo                String?
  settings            Json                 @default("{}")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  metalPremiumPercent Decimal              @default(0) @db.Decimal(5, 2)
  auditLogs           AuditLog[]
  categories          Category[]
  customerOrders      CustomerOrder[]
  goldRates           GoldRate[]
  inventoryItems      InventoryItem[]
  invoices            Invoice[]
  ledgerEntries       LedgerEntry[]
  metalRates          MetalRate[]
  metalRateHistories  MetalRateHistory[]
  metalTypes          MetalType[]
  parties             Party[]
  payments            Payment[]
  polishLabourConfigs PolishLabourConfig[]
  products            Product[]
  stockMovements      StockMovement[]
  users               User[]
  productCatalogs     ProductCatalog[]
  tagSequences        TagSequence[]
}

model User {
  id           String       @id @default(cuid())
  orgId        String
  name         String
  email        String       @unique
  passwordHash String
  role         UserRole     @default(OPERATOR)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  auditLogs    AuditLog[]
  invoices     Invoice[]
  org          Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model Party {
  id             String          @id @default(cuid())
  orgId          String
  name           String
  mobile         String?
  address        String?
  type           String          @default("Both")
  balance        Decimal         @default(0) @db.Decimal(14, 4)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  goldBalance    Decimal         @default(0) @db.Decimal(14, 4)
  karigarOrders  CustomerOrder[] @relation("OrderKarigar")
  customerOrders CustomerOrder[] @relation("OrderCustomer")
  suppliedItems  InventoryItem[]
  invoices       Invoice[]
  ledgerEntries  LedgerEntry[]
  org            Organization    @relation(fields: [orgId], references: [id])
  payments       Payment[]

  @@index([orgId])
  @@index([orgId, name])
  @@index([orgId, mobile])
}

model Category {
  id                 String              @id @default(cuid())
  orgId              String
  name               String
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  org                Organization        @relation(fields: [orgId], references: [id])
  customerOrderItems CustomerOrderItem[]
  invoiceItems       InvoiceItem[]
  products           Product[]

  @@unique([orgId, name])
  @@index([orgId])
}

model GoldRate {
  id        String       @id @default(cuid())
  orgId     String
  date      DateTime     @default(now())
  rate      Decimal      @db.Decimal(14, 4)
  carat     Int          @default(24)
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, date])
  @@index([orgId, carat])
}

model MetalRate {
  id          String       @id @default(cuid())
  orgId       String
  metal       String
  ratePerGram Decimal      @db.Decimal(14, 4)
  lastUpdated DateTime     @default(now())
  source      String       @default("API")
  updatedBy   String?
  org         Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, metal])
  @@index([orgId, metal])
}

model MetalRateHistory {
  id          String       @id @default(cuid())
  orgId       String
  metal       String
  ratePerGram Decimal      @db.Decimal(14, 4)
  recordedAt  DateTime     @default(now())
  source      String
  updatedBy   String?
  org         Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, metal, recordedAt])
}

model PolishLabourConfig {
  id          String       @id @default(cuid())
  orgId       String
  polishBasis String       @default("Per Tola")
  polishRate  Decimal      @db.Decimal(14, 4)
  labourBasis String       @default("Per Tola")
  labourRate  Decimal      @db.Decimal(14, 4)
  isDefault   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model Invoice {
  id                 String          @id @default(cuid())
  orgId              String
  orderNumber        Int             @default(autoincrement())
  receiptNo          String?
  date               DateTime        @default(now())
  dueDate            DateTime?
  rateType           RateType        @default(FIXED)
  status             InvoiceStatus   @default(DRAFT)
  transactionType    TransactionType @default(SALE)
  partyId            String?
  partyName          String?
  partyMobile        String?
  customerGoldWeight Decimal?        @db.Decimal(14, 4)
  customerGoldCarat  Int?
  customerGoldValue  Decimal?        @db.Decimal(14, 4)
  pasaRate           Decimal?        @db.Decimal(10, 4)
  pasaDeduction      Decimal?        @db.Decimal(14, 4)
  goldRate           Decimal?        @db.Decimal(14, 4)
  polishBasis        String?         @default("Per Tola")
  polishRate         Decimal?        @db.Decimal(14, 4)
  labourBasis        String?         @default("Per Tola")
  labourRate         Decimal?        @db.Decimal(14, 4)
  totalGoldWeight    Decimal         @default(0) @db.Decimal(14, 4)
  totalAmount        Decimal         @default(0) @db.Decimal(14, 4)
  otherCharges       Decimal         @default(0) @db.Decimal(14, 4)
  discount           Decimal         @default(0) @db.Decimal(14, 4)
  cashReceived       Decimal         @default(0) @db.Decimal(14, 4)
  goldReceived       Decimal         @default(0) @db.Decimal(14, 4)
  balance            Decimal         @default(0) @db.Decimal(14, 4)
  remarks            String?
  photos             String[]        @default([])
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  currency           String          @default("PKR")
  currencyRate       Decimal         @default(1) @db.Decimal(10, 4)
  intlOunceRate      Decimal         @default(0) @db.Decimal(14, 4)
  kaatBasis          String?         @default("Direct Weight")
  kaatRate           Decimal?        @default(0) @db.Decimal(14, 4)
  supplierInvoiceNo  String?
  auditLogs          AuditLog[]
  createdBy          User?           @relation(fields: [createdById], references: [id])
  org                Organization    @relation(fields: [orgId], references: [id])
  party              Party?          @relation(fields: [partyId], references: [id])
  items              InvoiceItem[]
  ledgerEntries      LedgerEntry[]
  payment            Payment?

  @@index([orgId, date])
  @@index([orgId, status])
  @@index([orgId, partyId])
  @@index([orgId, orderNumber])
}

model InvoiceItem {
  id                   String         @id @default(cuid())
  invoiceId            String
  sortOrder            Int            @default(0)
  categoryId           String?
  description          String?
  pieces               Int            @default(1)
  carat                Int            @default(24)
  size                 String?
  isRepairingOrder     Boolean        @default(false)
  isSampleGold         Boolean        @default(false)
  isBulkPurchase       Boolean        @default(false)
  estimatedGoldWeight  Decimal        @default(0) @db.Decimal(14, 4)
  adjustedGoldWeight   Decimal        @default(0) @db.Decimal(14, 4)
  estimatedGrossWeight Decimal        @default(0) @db.Decimal(14, 4)
  stoneWeight          Decimal        @default(0) @db.Decimal(14, 4)
  beadsWeight          Decimal        @default(0) @db.Decimal(14, 4)
  diamondWeight        Decimal        @default(0) @db.Decimal(14, 4)
  goldAmount           Decimal        @default(0) @db.Decimal(14, 4)
  stoneAmount          Decimal        @default(0) @db.Decimal(14, 4)
  beadsAmount          Decimal        @default(0) @db.Decimal(14, 4)
  diamondAmount        Decimal        @default(0) @db.Decimal(14, 4)
  polishAmount         Decimal        @default(0) @db.Decimal(14, 4)
  labourAmount         Decimal        @default(0) @db.Decimal(14, 4)
  totalAmount          Decimal        @default(0) @db.Decimal(14, 4)
  huid                 String?
  tagCaption           String?
  stoneRate            Decimal?       @db.Decimal(14, 4)
  imageUrl             String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  inventoryItemId      String?
  diamondEntries       Json?
  kaatWeight           Decimal        @default(0) @db.Decimal(14, 4)
  category             Category?      @relation(fields: [categoryId], references: [id])
  inventoryItem        InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  invoice              Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([inventoryItemId])
}

model ProductCatalog {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  prefix    String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, name])
  @@index([orgId, prefix])
}

model TagSequence {
  id      String       @id @default(cuid())
  orgId   String
  prefix  String
  lastSeq Int          @default(0)
  org     Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, prefix])
}

model AuditLog {
  id         String       @id @default(cuid())
  orgId      String
  userId     String?
  invoiceId  String?
  action     String
  entityType String
  entityId   String
  changes    Json?
  timestamp  DateTime     @default(now())
  invoice    Invoice?     @relation(fields: [invoiceId], references: [id])
  org        Organization @relation(fields: [orgId], references: [id])
  user       User?        @relation(fields: [userId], references: [id])

  @@index([orgId, timestamp])
  @@index([orgId, entityType, entityId])
}

model LedgerEntry {
  id          String              @id @default(cuid())
  orgId       String
  partyId     String
  invoiceId   String?
  type        LedgerType
  amount      Decimal             @db.Decimal(14, 4)
  balance     Decimal             @db.Decimal(14, 4)
  narration   String?
  date        DateTime            @default(now())
  paymentTxId String?             @unique
  invoice     Invoice?            @relation(fields: [invoiceId], references: [id])
  org         Organization        @relation(fields: [orgId], references: [id])
  party       Party               @relation(fields: [partyId], references: [id])
  paymentTx   PaymentTransaction? @relation(fields: [paymentTxId], references: [id])

  @@index([orgId, partyId, date])
  @@index([orgId, invoiceId])
}

model Payment {
  id                 String               @id @default(cuid())
  orgId              String
  partyId            String
  invoiceId          String?              @unique
  category           PaymentCategory
  status             PaymentStatus        @default(PENDING)
  totalAmount        Decimal              @db.Decimal(14, 4)
  paidAmount         Decimal              @default(0) @db.Decimal(14, 4)
  remainingAmount    Decimal              @db.Decimal(14, 4)
  invoiceDate        DateTime             @default(now())
  dueDate            DateTime
  paidDate           DateTime?
  isInstallmentBased Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  invoice            Invoice?             @relation(fields: [invoiceId], references: [id])
  org                Organization         @relation(fields: [orgId], references: [id])
  party              Party                @relation(fields: [partyId], references: [id])
  installments       PaymentInstallment[]
  reminders          PaymentReminder[]
  transactions       PaymentTransaction[]

  @@index([orgId, category])
  @@index([orgId, status])
  @@index([orgId, dueDate])
  @@index([orgId, partyId])
}

model PaymentTransaction {
  id          String       @id @default(cuid())
  paymentId   String
  amount      Decimal      @db.Decimal(14, 4)
  mode        PaymentMode
  date        DateTime     @default(now())
  goldWeight  Decimal?     @db.Decimal(14, 4)
  goldRate    Decimal?     @db.Decimal(14, 4)
  notes       String?
  createdAt   DateTime     @default(now())
  ledgerEntry LedgerEntry?
  payment     Payment      @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model PaymentInstallment {
  id            String        @id @default(cuid())
  paymentId     String
  installmentNo Int
  amount        Decimal       @db.Decimal(14, 4)
  dueDate       DateTime
  paidAmount    Decimal       @default(0) @db.Decimal(14, 4)
  status        PaymentStatus @default(PENDING)
  paidDate      DateTime?
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([dueDate])
}

model PaymentReminder {
  id        String   @id @default(cuid())
  paymentId String
  type      String
  channel   String
  sentAt    DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model MetalType {
  id                 String              @id @default(cuid())
  orgId              String
  name               String
  purity             String
  purityValue        Decimal             @default(0) @db.Decimal(10, 4)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  customerOrderItems CustomerOrderItem[]
  inventoryItems     InventoryItem[]
  org                Organization        @relation(fields: [orgId], references: [id])
  products           Product[]

  @@unique([orgId, name, purity])
  @@index([orgId])
}

model Product {
  id               String          @id @default(cuid())
  orgId            String
  name             String
  designCode       String?
  description      String?
  imageUrl         String?
  categoryId       String
  metalTypeId      String
  makingCharges    Decimal         @default(0) @db.Decimal(14, 4)
  makingChargeType String          @default("PER_GRAM")
  wastagePercent   Decimal         @default(0) @db.Decimal(5, 2)
  isActive         Boolean         @default(true)
  reorderThreshold Int             @default(0)
  isJewellery      Boolean         @default(true)
  isRetail         Boolean         @default(true)
  isWholesale      Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  inventoryItems   InventoryItem[]
  category         Category        @relation(fields: [categoryId], references: [id])
  metalType        MetalType       @relation(fields: [metalTypeId], references: [id])
  org              Organization    @relation(fields: [orgId], references: [id])

  @@index([orgId, categoryId])
  @@index([orgId, metalTypeId])
  @@index([orgId, designCode])
}

model InventoryItem {
  id             String          @id @default(cuid())
  orgId          String
  productId      String
  metalTypeId    String?
  supplierId     String?
  sku            String
  grossWeight    Decimal         @default(0) @db.Decimal(14, 4)
  netWeight      Decimal         @default(0) @db.Decimal(14, 4)
  stoneWeight    Decimal         @default(0) @db.Decimal(14, 4)
  otherWeight    Decimal         @default(0) @db.Decimal(14, 4)
  quantity       Int             @default(1)
  status         StockStatus     @default(AVAILABLE)
  location       String?
  importedAt     DateTime        @default(now())
  soldAt         DateTime?
  saleId         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  designCode     String?
  makingCharges  Decimal?        @db.Decimal(14, 4)
  retailPrice    Decimal         @default(0) @db.Decimal(14, 4)
  wastagePercent Decimal?        @db.Decimal(5, 2)
  wholesalePrice Decimal         @default(0) @db.Decimal(14, 4)
  metalType      MetalType?      @relation(fields: [metalTypeId], references: [id])
  org            Organization    @relation(fields: [orgId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  supplier       Party?          @relation(fields: [supplierId], references: [id])
  invoiceItems   InvoiceItem[]
  movements      StockMovement[]

  @@unique([orgId, sku])
  @@index([orgId, status])
  @@index([orgId, productId])
  @@index([orgId, supplierId])
}

model StockMovement {
  id              String        @id @default(cuid())
  orgId           String
  inventoryItemId String
  type            MovementType
  quantityChange  Int
  weightChange    Decimal       @default(0) @db.Decimal(14, 4)
  referenceId     String?
  remarks         String?
  createdAt       DateTime      @default(now())
  createdBy       String?
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  org             Organization  @relation(fields: [orgId], references: [id])

  @@index([orgId, inventoryItemId])
  @@index([orgId, type])
  @@index([orgId, createdAt])
}

model CustomerOrder {
  id                 String              @id @default(cuid())
  orgId              String
  orderNumber        Int                 @default(autoincrement())
  partyId            String?
  customCustomerName String?             @db.VarChar(255)
  karigarId          String?
  customKarigarName  String?             @db.VarChar(255)
  date               DateTime            @default(now())
  dueDate            DateTime?
  status             OrderStatus         @default(PENDING)
  totalAmount        Decimal             @default(0) @db.Decimal(14, 4)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  karigar            Party?              @relation("OrderKarigar", fields: [karigarId], references: [id])
  org                Organization        @relation(fields: [orgId], references: [id])
  party              Party?              @relation("OrderCustomer", fields: [partyId], references: [id])
  items              CustomerOrderItem[]

  @@index([orgId, date])
  @@index([orgId, status])
  @@index([orgId, partyId])
}

model CustomerOrderItem {
  id          String        @id @default(cuid())
  orderId     String
  description String?
  tagNo       String?
  categoryId  String?
  metalTypeId String?
  quantity    Int           @default(1)
  weight      Decimal       @default(0) @db.Decimal(14, 4)
  rate        Decimal       @default(0) @db.Decimal(14, 4)
  totalAmount Decimal       @default(0) @db.Decimal(14, 4)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  category    Category?     @relation(fields: [categoryId], references: [id])
  metalType   MetalType?    @relation(fields: [metalTypeId], references: [id])
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum RateType {
  FIXED
  UNFIXED
}

enum TransactionType {
  SALE
  PURCHASE
}

enum LedgerType {
  DEBIT
  CREDIT
}

enum PaymentCategory {
  RECEIVABLE
  PAYABLE
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMode {
  CASH
  BANK
  GOLD
  MIXED
}

enum StockStatus {
  AVAILABLE
  SOLD
  RESERVED
  RETURNED
  MEMO_OUT
}

enum MovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER
  OPENING_STOCK
}
